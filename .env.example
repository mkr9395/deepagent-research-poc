OPENAI_API_KEY=
TAVILY_API_KEY=

# LangSmith tracing (optional). Set LANGSMITH_TRACING=true to enable.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=deepagent-research-poc
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com   # only for EU region

# Tavily budget (code clamps these to ceilings 5 / 3 / 15)
TAVILY_MAX_CALLS_PER_TASK=5
TAVILY_MAX_RESEARCH_TASKS=3
TAVILY_MAX_CALLS_PER_REQUEST=15

# Models (optional; default gpt-6.1-terra)
ORCHESTRATOR_MODEL=
RESEARCHER_MODEL=
